FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      loadBalanceDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

enableBalancing     true;

inMemoryBalancing   true;

inMemoryMigrationFraction 0.10;

inMemoryMinLocalCells 1000;

inMemoryUseTimerGate false;

inMemoryRequiredGainFactor 1.05;

inMemoryAssumedBalanceCost 1.60;

reportBalancingTiming false;

maximumAllowableImbalance       0.16;

balanceCheckInterval    10;

balanceCooldownSteps    30;

loadBalancingUntilTime 1e10;

limitTimeDirBackups     1;

weightField     dsmcNMean_mixture;

// ************************************************************************* //
