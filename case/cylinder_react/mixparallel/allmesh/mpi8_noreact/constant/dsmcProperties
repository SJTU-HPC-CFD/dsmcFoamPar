FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dsmcProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// General Properties
// ~~~~~~~~~~~~~~~~~~

//- Number of real atoms/molecules represented by a parcel
//- XCX: mole density = 4e20/m^3, max cell vol = 7e-4, make sure max vol cell has 20 dsmc particles
nEquivalentParticles            6e9;


// Binary Collision Model
// ~~~~~~~~~~~~~~~~~~~~~~

BinaryCollisionModel        LarsenBorgnakkeVariableHardSphere;

LarsenBorgnakkeVariableHardSphereCoeffs
{
    rotationalRelaxationCollisionNumber   5.0;
}

// Collision Partner Selection Model
// ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

collisionPartnerSelectionModel        noTimeCounter;

// Time Step Model - constant or variable by cell volume(same as ours)
// ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

//timeStepModel   variable;

// Molecular species
// ~~~~~~~~~~~~~~~~~

typeIdList           (N2);

moleculeProperties
{
    N2
    {
        mass                                  46.5e-27;
        diameter                              4.17e-10;
        omega                                     0.74;
        alpha                                     1.36;
        rotationalDegreesOfFreedom                   2;
        nVibrationalModes                            1;
        characteristicVibrationalTemperature    (3371);
        dissociationTemperature                 113500;
        Zref                                   (52560);
        referenceTempForZref                    (3371);
        ionisationTemperature                 180798.3;
        charge                                       0;
    }
}



