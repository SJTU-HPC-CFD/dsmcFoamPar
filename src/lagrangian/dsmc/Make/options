ifeq ($(WM_COMPILER),Gcc)
OPENMP_FLAGS = -fopenmp
else
OPENMP_FLAGS = -qopenmp
endif

EXE_INC = \
    $(OPENMP_FLAGS) \
    -include $(WM_PROJECT_USER_DIR)/src/lagrangian/basic/lnInclude/hyCompatAPI.H \
    -I$(FOAM_SRC)/finiteVolume/lnInclude \
    -I$(WM_PROJECT_USER_DIR)/src/lagrangian/basic/lnInclude \
    -I$(FOAM_SRC)/meshTools/lnInclude \
    -I$(FOAM_SRC)/dynamicMesh/lnInclude \
    -I$(FOAM_SRC)/dynamicFvMesh/lnInclude \
    -I$(WM_PROJECT_USER_DIR)/src/lagrangian/molecularDynamics/general/lnInclude  \
    -I$(FOAM_SRC)/parallel/decompose/decompositionMethods/lnInclude \
    -I$(FOAM_SRC)/parallel/decompose/scotchDecomp/lnInclude \
    -I$(SCOTCH_ARCH_PATH)/include \
    -I$(PARMETIS_DIR)/include \
    -I$(MPI_ROOT)/include

LIB_LIBS = \
    $(OPENMP_FLAGS) \
    -L$(FOAM_USER_LIBBIN) \
    -llagrangian+ \
    -lfiniteVolume \
    -lmeshTools \
    -ldynamicMesh \
    -ldynamicFvMesh \
    -ltopoChangerFvMesh \
    -ldecompositionMethods \
    -lscotchDecomp \
    -L$(PARMETIS_DIR)/lib -lparmetis -lmetis \
    -lgeneralMolecule
