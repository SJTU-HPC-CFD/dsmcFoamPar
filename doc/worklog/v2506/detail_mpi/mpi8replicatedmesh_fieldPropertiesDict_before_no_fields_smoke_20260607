FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fieldPropertiesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dsmcFields
(
    field
    {
        fieldModel              dsmcVolFields;

        timeProperties
        {
            timeOption          write;
            resetAtOutput       on;
        }

        dsmcVolFieldsProperties
        {
            fieldName           mixture;
            typeIds             (N2 O2 NO N O);
            measureMeanFreePath true;
            mfpReferenceTemperature 273;
        }
    }
);
     
     
